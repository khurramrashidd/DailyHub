{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users/'+$uid+'/collaborators/'+auth.uid).exists() || root.child('admins/'+auth.uid).val() == true || auth.token.email == 'khurramrashid0786@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || root.child('admins/'+auth.uid).val() == true || auth.token.email == 'khurramrashid0786@gmail.com' || root.child('users/'+$uid+'/collaborators/'+auth.uid+'/role').val() == 'master' || root.child('users/'+$uid+'/collaborators/'+auth.uid+'/role').val() == 'add')",
        "sharedWithMe": {
          "$ownerUid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == $ownerUid || root.child('admins/'+auth.uid).val() == true || auth.token.email == 'khurramrashid0786@gmail.com')"
          }
        }
      }
    },

    "emailToUid": {
      ".read": "auth != null",
      "$escapedEmail": {
        ".write": "auth != null && (newData.child('uid').val() == auth.uid || auth.token.email == 'khurramrashid0786@gmail.com')"
      }
    },

    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.token.email == 'khurramrashid0786@gmail.com'",
        ".validate": "newData.isBoolean()"
      }
    },

    "broadcast": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins/'+auth.uid).val() == true || auth.token.email == 'khurramrashid0786@gmail.com')"
    },

    "adminAudit": {
      ".read": "auth != null && (root.child('admins/'+auth.uid).val() == true || auth.token.email == 'khurramrashid0786@gmail.com')",
      "$entryId": {
        ".write": "auth != null && (root.child('admins/'+auth.uid).val() == true || auth.token.email == 'khurramrashid0786@gmail.com') && !data.exists()",
        ".validate": "newData.hasChildren(['action','adminUid','targetUid','at'])"
      }
    }
  }
}
